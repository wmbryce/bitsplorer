# Dedicated Ethereum JSON-RPC endpoints, one per supported chain.
#
# All are OPTIONAL. When a var is unset the app falls back to viem's public
# default endpoint for that chain (see the table in DEPLOY.md). Those defaults
# are unauthenticated and rate-limit hard, so production should set all three.
#
# These are read server-side only and are deliberately NOT prefixed with
# NEXT_PUBLIC_ — a keyed provider URL is a credential and must not be shipped
# to the browser. Copy this file to .env.local for local development.

RPC_URL_MAINNET=
RPC_URL_SEPOLIA=
RPC_URL_BASE=
